PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/calendar-manager.sqlite
SESSION_SECRET=change-this-secret
INTEGRATION_ENCRYPTION_KEY=change-this-encryption-key
DEFAULT_TIMEZONE=America/Santo_Domingo

# Respaldos. Apuntar BACKUP_PATH a una carpeta sincronizada con la nube o a un
# recurso de red es todo lo que hace falta para que las copias salgan del equipo.
BACKUP_PATH=./data/backups
BACKUP_RETENTION=30
# BACKUP_ENABLED=false desactiva el respaldo automático del servidor.

# La cookie de sesión lleva el atributo Secure cuando NODE_ENV=production.
# COOKIE_SECURE=false permite servir por HTTP plano en una red local de confianza.
# Quítalo (o ponlo en true) en cuanto sirvas por HTTPS.
# COOKIE_SECURE=false

# Datos con los que arranca una base vacía:
#   blank -> solo los roles del sistema.
#   base  -> roles, departamentos y tipos de evento (predeterminado).
#   demo  -> agrega usuarios, calendarios, eventos y recursos de ejemplo
#            (contraseña Demo123!). Prohibido con NODE_ENV=production.
SEED_MODE=base

# Único usuario que se crea automáticamente en una base vacía.
# Obligatorios en producción. Mínimo 12 caracteres en la contraseña.
# Alternativa: npm run create-admin -- --email <correo> --password <clave>
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
